{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command' | grep -q '^git commit' && git push origin main || true",
            "if": "Bash(git commit*)",
            "statusMessage": "Haciendo push automático...",
            "async": true
          }
        ]
      }
    ]
  }
}
